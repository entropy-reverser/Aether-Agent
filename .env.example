# =============================================================================
# Aether-Agent v2 — Environment configuration template
# =============================================================================
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# All keys are read by app.config.Settings (pydantic-settings).
# =============================================================================

# --- LLM provider keys (Stage 1 routing does not call any LLM; used later) ---
OPENAI_API_KEY=
# Optional: local Llama-3-8B via Ollama for the PARSE tier
LOCAL_LLM_API_BASE=http://localhost:11434/v1

# --- Model tier mapping (which model each tier calls) ---
ROUTER_MODEL_COMPLEX=gpt-4o
ROUTER_MODEL_CHAT=gpt-4o-mini
ROUTER_MODEL_PARSE=llama3:8b

# --- Routing score thresholds (0-100). score<=PARSE_MAX -> PARSE,
#     PARSE_MAX < score <= CHAT_MAX -> CHAT, else COMPLEX. ---
ROUTING_PARSE_MAX=35
ROUTING_CHAT_MAX=55

# --- Storage paths (used from Stage 2 onward) ---
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./data/chroma
WIKI_DIR=./wiki

# --- New v2 file paths (NEW-1 / NEW-2 / NEW-3) ---
PROGRESS_FILE=PROGRESS.yaml
TASKS_FILE=TASKS.jsonl
CONTEXT_DIR=./data/context

# --- Optional feature flags ---
ENABLE_STREAMING=false
